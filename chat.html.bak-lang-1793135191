<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#B8543D">
  <title>Discussion — KWATTA</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            terra: { 50:'#fdf5f2',100:'#fbe8e2',200:'#f5d0c5',300:'#ecad9b',400:'#d97a63',500:'#B8543D',600:'#a3442f',700:'#873727',800:'#6e2f23',900:'#5a2a20' },
            cream: '#FAF6F0',
            charcoal: '#2D2A26',
            honey: '#E8A96A',
          },
          fontFamily: {
            display: ['"Space Grotesk"', 'system-ui', 'sans-serif'],
            body: ['Inter', 'system-ui', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/styles.css">
  <style>
    .message-bubble { max-width: 75%; word-wrap: break-word; }
    .message-mine { background: #B8543D; color: #FAF6F0; }
    .message-other { background: #fff; color: #2D2A26; border: 1px solid rgba(45,42,38,0.06); }
  </style>
</head>
<body class="bg-cream text-charcoal font-body antialiased h-screen flex flex-col">

  <header class="sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-charcoal/5">
    <div class="max-w-3xl mx-auto px-4 py-3 flex items-center gap-3">
      <button onclick="window.location.href='messages.html'" class="w-9 h-9 rounded-lg hover:bg-charcoal/5 flex items-center justify-center">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div id="other-user-header" class="flex items-center gap-3 flex-1 min-w-0">
        <div id="other-avatar" class="w-10 h-10 rounded-full bg-terra-100 flex items-center justify-center font-display font-bold text-terra-600">?</div>
        <div class="min-w-0">
          <div id="other-name" class="font-semibold truncate">...</div>
          <div id="other-username" class="text-xs text-charcoal/50 truncate"></div>
        </div>
      </div>
      <a id="whatsapp-link" href="#" target="_blank" class="hidden w-9 h-9 rounded-lg bg-green-500 text-white flex items-center justify-center hover:bg-green-600 transition">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
    </div>
    <button id="lang-toggle" class="w-9 h-9 rounded-lg hover:bg-charcoal/5 flex items-center justify-center text-xs font-bold" title="FR / EN" onclick="if(window.kwattaToggleLang) window.kwattaToggleLang()">
      <span id="current-lang">EN</span>
    </button>
  </header>

  <!-- Bandeau produit -->
  <div id="product-banner" class="hidden max-w-3xl mx-auto w-full px-4 pt-3">
    <a id="product-link" href="#" class="flex items-center gap-3 p-3 bg-white rounded-2xl border border-charcoal/5 hover:border-terra-500/30 transition">
      <img id="product-img" src="" class="w-12 h-12 rounded-lg object-cover bg-charcoal/5">
      <div class="flex-1 min-w-0">
        <div class="text-xs text-charcoal/50">Article</div>
        <div id="product-title" class="font-semibold text-sm truncate"></div>
        <div id="product-price" class="text-sm text-terra-600 font-bold"></div>
      </div>
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
    </a>
  </div>

  <!-- Messages -->
  <main id="messages-container" class="flex-1 overflow-y-auto max-w-3xl mx-auto w-full px-4 py-4 space-y-3">
    <div class="text-center py-8">
      <div class="inline-block w-8 h-8 border-4 border-terra-500 border-t-transparent rounded-full animate-spin"></div>
    </div>
  </main>

  <!-- Formulaire -->
  <div class="sticky bottom-0 bg-cream/95 backdrop-blur border-t border-charcoal/5 p-3">
    <form id="message-form" class="max-w-3xl mx-auto flex items-end gap-2">
      <textarea id="message-input" rows="1" placeholder="Écrire un message..."
        class="flex-1 px-4 py-3 bg-white border border-charcoal/10 rounded-2xl text-sm focus:border-terra-500 outline-none resize-none max-h-32"
        style="min-height: 48px;"></textarea>
      <button type="submit" id="send-btn"
        class="w-12 h-12 rounded-full bg-terra-500 hover:bg-terra-600 text-cream flex items-center justify-center transition shrink-0">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="js/supabase-init.js"></script>
  <script src="js/verified-badge.js"></script>
  <script>
    const $ = (id) => document.getElementById(id);
    let currentUser = null;
    let otherUser = null;
    let currentListingId = null;
    let realtimeChannel = null;

    const urlParams = new URLSearchParams(window.location.search);
    const otherUserId = urlParams.get('user');
    currentListingId = urlParams.get('listing') || null;

    if (!otherUserId) {
      window.location.href = 'messages.html';
    }

    function formatPrice(p) {
      return new Intl.NumberFormat('fr-FR').format(p) + ' FCFA';
    }

    // ============================================
    // INIT
    // ============================================
    (async () => {
      const { data: { session } } = await window.kwatta_db.auth.getSession();
      if (!session) { window.location.href = 'index.html'; return; }
      currentUser = session.user;

      // 1) Charge le profil PUBLIC de l'autre
      const { data: publicProfile } = await window.kwatta_db
        .from('profiles')
        .select('id, username, display_name, avatar_url, is_verified')
        .eq('id', otherUserId)
        .single();

      if (!publicProfile) {
        console.warn('[CHAT] Profil introuvable');
        return;
      }

      // 2) Essaie de récupérer le whatsapp (autorisé seulement si conversation existe)
      const { data: contactData } = await window.kwatta_db
        .rpc('get_chat_contact', { p_user_id: otherUserId });

      // 3) Fusionne public + privé
      const profile = {
        ...publicProfile,
        whatsapp: contactData?.whatsapp || null,
        phone_original: contactData?.phone_original || null,
      };

      otherUser = profile;
      const name = profile.display_name || profile.username;
      const verifiedBadge = window.renderVerifiedBadge ? window.renderVerifiedBadge(profile.is_verified, 'md') : '';
      $('other-name').innerHTML = name + verifiedBadge;
      $('other-username').textContent = '@' + profile.username;

      if (profile.avatar_url) {
        $('other-avatar').innerHTML = '<img src="' + profile.avatar_url + '" class="w-full h-full object-cover" alt="Avatar">';
      } else {
        $('other-avatar').textContent = name[0].toUpperCase();
      }

      // Affiche le bouton WhatsApp si whatsapp dispo
      if (profile.whatsapp) {
        const phone = profile.whatsapp.replace(/[^0-9]/g, '');
        $('whatsapp-link').href = `https://wa.me/${phone}`;
        $('whatsapp-link').classList.remove('hidden');
      }

      // Charge le produit si présent
      if (currentListingId) {
        const { data: listing } = await window.kwatta_db
          .from('listings')
          .select('id, title, price_xaf, images')
          .eq('id', currentListingId)
          .single();

        if (listing) {
          $('product-title').textContent = listing.title;
          $('product-price').textContent = formatPrice(listing.price_xaf);
          $('product-img').src = (listing.images && listing.images[0]) || 'https://placehold.co/100x100/f5f3ee/2D2A26?text=K';
          $('product-link').href = `product.html?id=${listing.id}`;
          $('product-banner').classList.remove('hidden');
        }
      }

      await loadMessages();
      subscribeRealtime();
    })();

    // ============================================
    // CHARGER LES MESSAGES
    // ============================================
    async function loadMessages() {
      let query = window.kwatta_db
        .from('messages')
        .select('*')
        .or(`and(sender_id.eq.${currentUser.id},receiver_id.eq.${otherUserId}),and(sender_id.eq.${otherUserId},receiver_id.eq.${currentUser.id})`)
        .order('created_at', { ascending: true });

      if (currentListingId) {
        query = query.eq('listing_id', currentListingId);
      } else {
        query = query.is('listing_id', null);
      }

      const { data, error } = await query;
      if (error) { console.error(error); return; }

      renderMessages(data || []);

      // Marque comme lus les messages reçus
      await window.kwatta_db
        .from('messages')
        .update({ is_read: true })
        .eq('receiver_id', currentUser.id)
        .eq('sender_id', otherUserId)
        .eq('is_read', false);
    }

    function renderMessages(messages) {
      const container = $('messages-container');
      if (messages.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12 text-charcoal/50">
            <div class="text-5xl mb-2">💬</div>
            <p class="text-sm">Démarrez la conversation</p>
          </div>`;
        return;
      }

      container.innerHTML = messages.map(m => {
        const isMine = m.sender_id === currentUser.id;
        const time = new Date(m.created_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
        const date = new Date(m.created_at).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' });
        return `
          <div class="flex ${isMine ? 'justify-end' : 'justify-start'}">
            <div class="message-bubble ${isMine ? 'message-mine' : 'message-other'} rounded-2xl px-4 py-2.5">
              <div class="text-sm whitespace-pre-wrap">${escapeHtml(m.content)}</div>
              <div class="text-[10px] mt-1 ${isMine ? 'text-cream/70' : 'text-charcoal/40'} text-right">${time}</div>
            </div>
          </div>
        `;
      }).join('');

      container.scrollTop = container.scrollHeight;
    }

    function escapeHtml(s) {
      const d = document.createElement('div');
      d.textContent = s || '';
      return d.innerHTML;
    }

    // ============================================
    // ENVOYER UN MESSAGE
    // ============================================
    $('message-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = $('message-input');
      const content = input.value.trim();
      if (!content) return;

      input.value = '';
      input.style.height = 'auto';

      const { error } = await window.kwatta_db
        .from('messages')
        .insert({
          sender_id: currentUser.id,
          receiver_id: otherUserId,
          listing_id: currentListingId,
          content
        });

      if (error) {
        console.error(error);
        alert('Erreur d\'envoi');
        return;
      }

      await loadMessages();
    });

    // Auto-resize textarea
    $('message-input').addEventListener('input', (e) => {
      e.target.style.height = 'auto';
      e.target.style.height = Math.min(e.target.scrollHeight, 128) + 'px';
    });

    // ============================================
    // REALTIME
    // ============================================
    function subscribeRealtime() {
      realtimeChannel = window.kwatta_db
        .channel('messages-chat')
        .on('postgres_changes',
          { event: 'INSERT', schema: 'public', table: 'messages' },
          (payload) => {
            const m = payload.new;
            if (
              (m.sender_id === currentUser.id && m.receiver_id === otherUserId) ||
              (m.sender_id === otherUserId && m.receiver_id === currentUser.id)
            ) {
              loadMessages();
            }
          }
        )
        .subscribe();
    }
  </script>
  <script src="js/bottom-nav.js" defer></script>
</body>
</html>
