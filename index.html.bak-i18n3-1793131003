              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Continuer avec Google
          </button>

          <button type="button" id="phone-signup-btn"
            class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded-xl border border-charcoal/15 bg-white hover:bg-charcoal/5 transition font-semibold text-sm">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="5" y="2" width="14" height="20" rx="2"/>
              <path d="M12 18h.01"/>
            </svg>
            S'inscrire avec mon numéro
          </button>
        </div>

        <!-- Séparateur -->
        <div class="relative mb-4">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-charcoal/10"></div>
          </div>
          <div class="relative flex justify-center text-xs">
            <span class="px-3 bg-white text-charcoal/50">ou</span>
          </div>
        </div>
        <!-- Bandeau mode téléphone -->
        <div id="auth-phone-banner" class="hidden mb-3 p-3 bg-blue-50 border border-blue-200 rounded-xl">
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="text-lg">📱</span>
              <div>
                <div class="text-xs font-bold text-blue-900">Inscription par téléphone</div>
                <div class="text-[10px] text-blue-700">Aucun email requis maintenant</div>
              </div>
            </div>
            <button type="button" id="cancel-phone-signup" class="text-xs text-blue-700 hover:underline font-semibold">
              Annuler
            </button>
          </div>
        </div>

        <form id="auth-form" class="space-y-3">
          <!-- Champ téléphone (visible seulement en mode signup_phone) -->
          <div id="auth-phone-field" class="hidden">
            <label class="block text-xs font-mono uppercase text-charcoal/50 mb-1">Numéro de téléphone</label>
            <input type="tel" id="auth-phone" autocomplete="tel"
              class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none"
              placeholder="+237 6XX XXX XXX">
            <p class="text-xs text-charcoal/50 mt-1">Format : 6XX XXX XXX ou +237 6XX XXX XXX</p>
          </div>

          <div id="auth-name-field" class="hidden">
            <label class="block text-xs font-mono uppercase text-charcoal/50 mb-1">Nom complet</label>
            <input type="text" id="auth-name" 
              class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none">
          </div>

          <div id="auth-username-field" class="hidden">
            <label class="block text-xs font-mono uppercase text-charcoal/50 mb-1">Nom d'utilisateur</label>
            <input type="text" id="auth-username" minlength="3"
              class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none"
              placeholder="votre_nom_utilisateur">
          </div>

          <div>
            <label class="block text-xs font-mono uppercase text-charcoal/50 mb-1">Email</label>
            <input type="email" id="auth-email" required autocomplete="email"
              class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none"
              placeholder="votre.email@exemple.com">
          </div>

          <div id="auth-whatsapp-field" class="hidden">
            <label class="block text-xs font-mono uppercase text-charcoal/50 mb-1">WhatsApp</label>
            <input type="tel" id="auth-whatsapp" 
              class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none"
              placeholder="+237 6XX XXX XXX">
          </div>

          <div>
            <label class="block text-xs font-mono uppercase text-charcoal/50 mb-1">Mot de passe</label>
            <input type="password" id="auth-password" required minlength="6" autocomplete="current-password"
              class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none"
              placeholder="Votre mot de passe">
          </div>

          <div id="auth-terms-field" class="hidden flex items-start gap-2 pt-1">
            <input type="checkbox" id="auth-terms" class="mt-1 w-4 h-4 text-terra-500 rounded focus:ring-terra-500">
            <label for="auth-terms" class="text-xs text-charcoal/60">
              J'accepte les <a href="conditions.html" target="_blank" class="text-terra-600 underline">Conditions</a>
              et la <a href="confidentialite.html" target="_blank" class="text-terra-600 underline">Politique de confidentialité</a>
            </label>
          </div>

          <p id="auth-error" class="text-sm text-red-600 hidden"></p>

          <button type="submit" id="auth-submit"
            class="w-full py-3 rounded-xl bg-terra-500 hover:bg-terra-600 text-cream font-semibold transition shadow-lg shadow-terra-500/30">
            Se connecter
          </button>
        </form>

        <div class="mt-4 text-center">
          <button id="auth-switch" class="text-sm text-terra-600 hover:underline">
            Pas de compte ? Créer un compte
          </button>
        </div>
      </div>

    </div>
  </div>

  <script src="js/notifications.js" defer></script>
  <script src="js/verify-badge.js" defer></script>

</body>
</html>
