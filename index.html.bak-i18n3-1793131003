<style id="kwatta-nav-css">
    /* ============================================
       NAV CATÉGORIES (barre horizontale scrollable)
       ============================================ */
    #categories {
      position: relative;
      background: #FAF6F0;
      border-bottom: 1px solid rgba(45, 42, 38, 0.08);
      z-index: 30;
    }

    .cat-nav-scroll {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      max-width: 100vw;
    }
    .cat-nav-scroll::-webkit-scrollbar { display: none; }

    #categories-nav {
      display: flex;
      min-height: 52px;
      align-items: stretch;
      width: max-content;
    }
    #categories-nav > * { flex-shrink: 0; }

    /* ============================================
       CONTAINER DU MENU (hors flux de scroll)
       ============================================ */
    #cat-mega-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 0;
      overflow: visible;
      pointer-events: none;
      z-index: 9999;
    }

    /* ============================================
       LIENS DE LA NAV
       ============================================ */
    .cat-nav-link {
      display: inline-flex;
      align-items: center;
      padding: 16px 14px;
      font-size: 14px;
      font-weight: 500;
      color: #7A7A7A;
      text-decoration: none;
      white-space: nowrap;
      border-bottom: 2px solid transparent;
      transition: color 0.15s, border-color 0.15s;
      cursor: pointer;
    }
    .cat-nav-link:hover,
    .cat-nav-item.open .cat-nav-link {
      color: #B8543D;
      border-bottom-color: #B8543D;
    }
    .cat-nav-link svg {
      margin-left: 4px;
      transition: transform 0.2s;
    }
    .cat-nav-item.open .cat-nav-link svg { transform: rotate(180deg); }

    /* ============================================
       MEGA-MENU
       ============================================ */
    .cat-mega-menu {
      display: none;
      position: fixed;
      background: #fff;
      border: 1px solid rgba(45, 42, 38, 0.08);
      border-radius: 12px;
      box-shadow: 0 20px 40px rgba(45, 42, 38, 0.15);
      z-index: 99999;
      pointer-events: auto;
      max-width: calc(100vw - 32px);
      overflow: hidden;
    }
    .cat-mega-menu.open {
      display: block;
    }

    .cat-mega-menu-inner {
      display: grid;
      grid-template-columns: 200px 1fr;
      min-height: 280px;
      max-height: 480px;
    }

    /* Colonne gauche : niveau 2 */
    .cat-mega-col-left {
      background: #FAF6F0;
      padding: 12px 8px;
      border-right: 1px solid rgba(45, 42, 38, 0.05);
      overflow-y: auto;
      max-height: 480px;
    }
    .cat-mega-item-all {
      display: block;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: 600;
      color: #B8543D;
      text-decoration: none;
      border-radius: 6px;
      margin-bottom: 4px;
      border-bottom: 1px solid rgba(184, 84, 61, 0.1);
      padding-bottom: 10px;
    }
    .cat-mega-parent {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 9px 12px;
      font-size: 13px;
      font-weight: 500;
      color: #2D2A26;
      text-decoration: none;
      border-radius: 6px;
      transition: background 0.1s, color 0.1s;
      cursor: pointer;
    }
    .cat-mega-parent:hover,
    .cat-mega-parent.active {
      background: #fff;
      color: #B8543D;
      box-shadow: 0 2px 6px rgba(45, 42, 38, 0.06);
    }
    .cat-arrow {
      opacity: 0.4;
      font-size: 16px;
      line-height: 1;
    }
    .cat-mega-parent.active .cat-arrow {
      opacity: 1;
      color: #B8543D;
    }

    /* Colonne droite : niveau 3 */
    .cat-mega-col-right {
      padding: 16px 20px;
      overflow-y: auto;
      max-height: 480px;
      background: #fff;
      min-width: 260px;
    }
    .cat-mega-subpanel { display: none; }
    .cat-mega-subpanel.active { display: block; }

    .cat-mega-subtitle {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #7A7A7A;
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 1px solid rgba(45, 42, 38, 0.05);
    }
    .cat-mega-subitem {
      display: block;
      padding: 7px 8px;
      font-size: 13px;
      color: #2D2A26;
      text-decoration: none;
      border-radius: 6px;
      transition: background 0.1s, color 0.1s;
    }
    .cat-mega-subitem:hover {
      background: #fdf5f2;
      color: #B8543D;
    }
  </style>

<style id="thebox-badge-css">
  /* ============================================
     BADGE THE BOX — High-tech style
     ============================================ */
  .thebox-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(37, 99, 235, 0.08));
    border: 1px solid rgba(59, 130, 246, 0.35);
    box-shadow: 
      0 0 10px rgba(59, 130, 246, 0.25),
      inset 0 0 10px rgba(59, 130, 246, 0.05);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .thebox-badge::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    transition: left 0.5s;
  }
  .thebox-badge:hover::before {
    left: 100%;
  }
  .thebox-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3B82F6;
    box-shadow: 0 0 8px #3B82F6, 0 0 12px rgba(59, 130, 246, 0.6);
    animation: thebox-pulse 2s ease-in-out infinite;
  }
  @keyframes thebox-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }
  .thebox-text {
    font-family: 'Space Grotesk', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #60A5FA;
    text-shadow: 0 0 8px rgba(96, 165, 250, 0.5);
  }
  .thebox-badge:hover {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.25), rgba(37, 99, 235, 0.15));
    border-color: rgba(59, 130, 246, 0.6);
    box-shadow: 
      0 0 15px rgba(59, 130, 246, 0.4),
      inset 0 0 15px rgba(59, 130, 246, 0.1);
  }
  .thebox-badge:hover .thebox-text {
    color: #93C5FD;
    text-shadow: 0 0 12px rgba(147, 197, 253, 0.8);
  }

  /* Version mobile : réduire */
  @media (max-width: 640px) {
    .thebox-badge {
      padding: 3px 8px;
    }
    .thebox-text {
      font-size: 10px;
    }
  }
</style>
<style id="how-icons-css">
  /* ============================================
     ICONES "COMMENT ÇA MARCHE" — Modern
     ============================================ */
  .how-icon-wrap {
    width: 88px;
    height: 88px;
    margin: 0 auto 16px;
    border-radius: 24px;
    background: linear-gradient(135deg, #B8543D 0%, #873727 100%);
    padding: 3px;
    position: relative;
    box-shadow: 
      0 8px 20px rgba(184, 84, 61, 0.25),
      0 4px 8px rgba(184, 84, 61, 0.1);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .how-icon-wrap::before {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 30px;
    background: radial-gradient(circle, rgba(184, 84, 61, 0.15) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .how-icon-wrap:hover {
    transform: translateY(-4px) scale(1.05);
    box-shadow: 
      0 12px 28px rgba(184, 84, 61, 0.35),
      0 6px 12px rgba(184, 84, 61, 0.15);
  }
  .how-icon-wrap:hover::before {
    opacity: 1;
  }
  .how-icon-inner {
    width: 100%;
    height: 100%;
    border-radius: 21px;
    background: linear-gradient(135deg, rgba(184, 84, 61, 0.95) 0%, rgba(135, 55, 39, 0.95) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .how-icon-inner::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
    transition: left 0.6s;
  }
  .how-icon-wrap:hover .how-icon-inner::after {
    left: 100%;
  }

  @media (max-width: 640px) {
    .how-icon-wrap {
      width: 72px;
      height: 72px;
      border-radius: 20px;
    }
    .how-icon-inner {
      border-radius: 17px;
    }
    .how-icon-inner svg {
      width: 26px;
      height: 26px;
    }
  }
</style>
</head>



