<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#B8543D">
  <title>Messages — KWATTA</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            terra: { 50:'#fdf5f2',100:'#fbe8e2',200:'#f5d0c5',300:'#ecad9b',400:'#d97a63',500:'#B8543D',600:'#a3442f',700:'#873727',800:'#6e2f23',900:'#5a2a20' },
            cream: '#FAF6F0',
            charcoal: '#2D2A26',
            honey: '#E8A96A',
          },
          fontFamily: {
            display: ['"Space Grotesk"', 'system-ui', 'sans-serif'],
            body: ['Inter', 'system-ui', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/styles.css">
  <link rel="stylesheet" href="css/theme-green.css">
  <script src="js/i18n.js"></script>
  <script src="js/app.js"></script>
</head>
<body class="bg-cream text-charcoal font-body antialiased">

  <header class="sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-charcoal/5">
    <div class="max-w-3xl mx-auto px-4 py-3 flex items-center gap-3">
      <a href="index.html" class="w-9 h-9 rounded-lg hover:bg-charcoal/5 flex items-center justify-center">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
      </a>
      <h1 class="font-display font-bold text-lg">Messages</h1>
    <button id="lang-toggle" class="w-9 h-9 rounded-lg hover:bg-charcoal/5 flex items-center justify-center text-xs font-bold" title="FR / EN" onclick="if(window.kwattaToggleLang) window.kwattaToggleLang()">
        <span id="current-lang">EN</span>
      </button>
      </div>
    
  </header>

  <div id="loading" class="text-center py-16">
    <div class="inline-block w-8 h-8 border-4 border-terra-500 border-t-transparent rounded-full animate-spin"></div>
  </div>

  <main id="conversations-list" class="hidden max-w-3xl mx-auto px-4 py-4 pb-24 sm:pb-8 space-y-2"></main>

  <nav class="bottom-nav">
    <a href="index.html" class="bottom-nav-item">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      </svg>
      <span>Accueil</span>
    </a>
    <a href="search.html" class="bottom-nav-item">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <span>Rechercher</span>
    </a>
    <a href="sell.html" class="bottom-nav-item bottom-nav-center">
      <div class="w-12 h-12 rounded-full bg-terra-500 flex items-center justify-center -mt-6 shadow-lg shadow-terra-500/40">
        <svg width="24" height="24" fill="none" stroke="#fff" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
      </div>
      <span>Vendre</span>
    </a>
    <a href="messages.html" class="bottom-nav-item active">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <span>Messages</span>
    </a>
    <a href="profile.html" class="bottom-nav-item">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="12" cy="8" r="4"/><path d="M4 21v-2a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v2"/>
      </svg>
      <span>Profil</span>
    </a>
  </nav>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="js/supabase-init.js"></script>
  <script src="js/verified-badge.js"></script>
  <script>
    const $ = (id) => document.getElementById(id);
    let currentUser = null;

    (async () => {
      const { data: { session } } = await window.kwatta_db.auth.getSession();
      if (!session) { window.location.href = 'index.html'; return; }
      currentUser = session.user;

      // Récupère tous les messages où je suis sender ou receiver
      const { data: messages, error } = await window.kwatta_db
        .from('messages')
        .select('*, listing:listings(id, title, images), sender:profiles!messages_sender_id_fkey(id, username, display_name, avatar_url, is_verified), receiver:profiles!messages_receiver_id_fkey(id, username, display_name, avatar_url, is_verified)')
        .or(`sender_id.eq.${currentUser.id},receiver_id.eq.${currentUser.id}`)
        .order('created_at', { ascending: false });

      if (error) {
        console.error(error);
        $('loading').innerHTML = '<p class="text-charcoal/60">Erreur de chargement</p>';
        return;
      }

      // Groupe par "autre utilisateur + listing"
      const conversationsMap = {};
      (messages || []).forEach(m => {
        const isMe = m.sender_id === currentUser.id;
        const otherUser = isMe ? m.receiver : m.sender;
        if (!otherUser) return;
        
        const key = `${otherUser.id}_${m.listing_id || 'general'}`;
        if (!conversationsMap[key]) {
          conversationsMap[key] = {
            otherUser,
            listing: m.listing,
            lastMessage: m,
            unread: 0
          };
        }
        // Compte les non-lus
        if (!isMe && !m.is_read) conversationsMap[key].unread++;
      });

      const conversations = Object.values(conversationsMap);
      renderConversations(conversations);
      $('loading').classList.add('hidden');
    })();

    function renderConversations(list) {
      const container = $('conversations-list');
      container.classList.remove('hidden');

      if (list.length === 0) {
        container.innerHTML = `
          <div class="text-center py-16">
            <div class="text-6xl mb-3">💬</div>
            <p class="text-charcoal/60">Aucune conversation</p>
            <p class="text-sm text-charcoal/40 mt-1">Commencez par contacter un vendeur</p>
            <a href="index.html" class="inline-block mt-4 px-5 py-3 bg-terra-500 text-cream rounded-xl font-semibold text-sm">Parcourir les articles</a>
          </div>`;
        return;
      }

      container.innerHTML = list.map(c => {
        const other = c.otherUser;
        const name = other.display_name || other.username || 'Utilisateur';
        const initial = name[0].toUpperCase();
        const avatarHtml = other.avatar_url
          ? '<img src="' + other.avatar_url + '" class="w-full h-full object-cover" alt="Avatar">'
          : initial;
        const lastMsg = c.lastMessage.content || '';
        const preview = lastMsg.length > 50 ? lastMsg.slice(0, 50) + '...' : lastMsg;
        const date = new Date(c.lastMessage.created_at).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' });
        const productTitle = c.listing ? c.listing.title : 'Discussion générale';
        const productImg = c.listing && c.listing.images && c.listing.images[0] ? c.listing.images[0] : null;
        const unreadBadge = c.unread > 0 ? `<span class="ml-auto bg-terra-500 text-cream text-xs font-bold px-2 py-0.5 rounded-full">${c.unread}</span>` : '';
        const verifiedBadge = window.renderVerifiedBadge ? window.renderVerifiedBadge(other.is_verified, 'sm') : '';

        return `
          <a href="chat.html?user=${other.id}&listing=${c.listing ? c.listing.id : ''}" 
             class="flex items-center gap-3 p-3 bg-white rounded-2xl border border-charcoal/5 hover:border-terra-500/30 transition">
            <div class="w-12 h-12 rounded-full bg-terra-100 flex items-center justify-center font-display font-bold text-terra-600 text-lg shrink-0 overflow-hidden">
              ${avatarHtml}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="font-semibold truncate">${name}</span>${verifiedBadge}
                ${unreadBadge}
              </div>
              <div class="text-xs text-charcoal/50 truncate">📦 ${productTitle}</div>
              <div class="text-sm text-charcoal/70 truncate mt-0.5">${preview}</div>
            </div>
            <div class="text-xs text-charcoal/40 shrink-0">${date}</div>
          </a>
        `;
      }).join('');
    }
  </script>
</body>
</html>
