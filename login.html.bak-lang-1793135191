        </form>

        <div class="mt-5 text-center space-y-2">
          <p class="text-sm text-charcoal/60">
            Pas de compte ? 
            <button id="show-signup-btn" class="text-terra-600 hover:underline font-semibold">
              Inscrivez-vous
            </button>
          </p>
          <a href="#" class="text-xs text-charcoal/50 hover:text-terra-600 block">
            Mot de passe oublié ?
          </a>
        </div>
      </div>

      <!-- Formulaire SIGNUP (caché) -->
      <div id="form-signup" class="hidden bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-charcoal/5">
        
        <h1 class="font-display text-2xl font-bold text-center mb-2">
          Créez votre compte KWATTA
        </h1>
        <p class="text-sm text-charcoal/60 text-center mb-6">
          Rejoignez la communauté
        </p>

        <!-- Bandeau Mode téléphone (caché) -->
        <div id="phone-banner" class="hidden mb-5 p-3 bg-blue-50 border border-blue-200 rounded-xl">
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="text-lg">📱</span>
              <div>
                <div class="text-xs font-bold text-blue-900">Inscription par téléphone</div>
                <div class="text-[10px] text-blue-700">Aucun email requis maintenant</div>
