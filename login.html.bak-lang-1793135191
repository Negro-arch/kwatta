<body class="bg-cream text-charcoal font-body antialiased min-h-screen">

  <!-- Header simple -->
  <header class="p-4">
    <a href="index.html" class="inline-flex items-center gap-2">
      <div class="w-9 h-9 rounded-xl bg-terra-500 flex items-center justify-center shadow-sm">
        <span class="text-cream font-display font-bold text-lg">K</span>
      </div>
      <span class="font-display font-bold text-xl">KWATTA</span>
    </a>
    <button id="lang-toggle" class="w-9 h-9 rounded-lg hover:bg-charcoal/5 flex items-center justify-center text-xs font-bold" title="FR / EN" onclick="if(window.kwattaToggleLang) window.kwattaToggleLang()">
      <span id="current-lang">EN</span>
    </button>
  </header>

  <!-- Contenu centré -->
  <main class="flex items-center justify-center px-4 pb-8" style="min-height: calc(100vh - 100px);">
    <div class="w-full max-w-md">

      <!-- Formulaire LOGIN -->
      <div id="form-login" class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-charcoal/5">
        
        <h1 class="font-display text-2xl font-bold text-center mb-2">
          Rejoignez KWATTA et vendez vos articles sans frais
        </h1>
        <p class="text-sm text-charcoal/60 text-center mb-6">
          Connectez-vous pour continuer
        </p>

        <!-- Boutons sociaux -->
        <div class="space-y-2 mb-5">
          
          <!-- Google -->
          <button type="button" id="google-login-btn"
            class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded-xl border border-charcoal/15 bg-white hover:bg-charcoal/5 transition font-medium text-sm">
            <svg width="18" height="18" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
