          </div>
          <p id="login-error" class="text-sm text-red-600 hidden"></p>
          <button type="submit"
            class="w-full py-3 rounded-xl bg-terra-500 hover:bg-terra-600 text-cream font-semibold transition shadow-lg shadow-terra-500/30">
            Se connecter
