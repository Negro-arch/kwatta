<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#B8543D">
  <title>Vendre — KWATTA</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            terra: { 50:'#fdf5f2',100:'#fbe8e2',200:'#f5d0c5',300:'#ecad9b',400:'#d97a63',500:'#B8543D',600:'#a3442f',700:'#873727',800:'#6e2f23',900:'#5a2a20' },
            cream: '#FAF6F0',
            charcoal: '#2D2A26',
            honey: '#E8A96A',
          },
          fontFamily: {
            display: ['"Space Grotesk"', 'system-ui', 'sans-serif'],
            body: ['Inter', 'system-ui', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/styles.css">
  <script src="js/locations.js"></script>
</head>
<body class="bg-cream text-charcoal font-body antialiased">

  <header class="sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-charcoal/5">
    <div class="max-w-3xl mx-auto px-4 py-3 flex items-center gap-3">
      <a href="index.html" class="w-9 h-9 rounded-lg hover:bg-charcoal/5 flex items-center justify-center">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
      </a>
      <h1 class="font-display font-bold text-lg">Vendre un article</h1>
      <div class="flex-1"></div>
    </div>
    <button id="lang-toggle" class="w-9 h-9 rounded-lg hover:bg-charcoal/5 flex items-center justify-center text-xs font-bold" title="FR / EN" onclick="if(window.kwattaToggleLang) window.kwattaToggleLang()">
      <span id="current-lang">EN</span>
    </button>
  </header>

  <!-- Loading -->
  <div id="loading" class="text-center py-16">
    <div class="inline-block w-8 h-8 border-4 border-terra-500 border-t-transparent rounded-full animate-spin"></div>
  </div>

  <!-- Message si non connecté -->
  <div id="login-required" class="hidden max-w-md mx-auto px-4 py-16 text-center">
    <div class="text-6xl mb-4">🔒</div>
    <h2 class="font-display text-2xl font-bold mb-2">Connectez-vous pour vendre</h2>
    <p class="text-charcoal/60 mb-6">Vous devez avoir un compte KWATTA pour publier une annonce.</p>
    <button onclick="window.kwattaOpenAuth ? window.kwattaOpenAuth('signup') : window.location.href='login.html'" 
      class="inline-block px-6 py-3 rounded-xl bg-terra-500 hover:bg-terra-600 text-cream font-semibold transition">
      Créer un compte
    </button>
  </div>
<!-- FORMULAIRE -->
  <main id="sell-content" class="hidden max-w-3xl mx-auto px-4 py-6 pb-24 sm:pb-8">
    <form id="sell-form" class="space-y-6">

      <!-- PHOTOS -->
      <div class="bg-white rounded-2xl p-5 border border-charcoal/5">
        <label class="block font-semibold mb-3">
          Photos <span class="text-red-500">*</span>
          <span class="text-xs text-charcoal/50 font-normal ml-2">(1 minimum, 5 maximum)</span>
        </label>
        
        <!-- Zone d'upload -->
        <div id="upload-zone" class="border-2 border-dashed border-charcoal/15 rounded-2xl p-6 text-center cursor-pointer hover:border-terra-500/50 transition">
          <div class="text-5xl mb-3">📷</div>
          <p class="font-semibold mb-1">Ajouter des photos</p>
          <p class="text-xs text-charcoal/50 mb-4">Depuis votre appareil ou la caméra</p>
          
          <div class="flex flex-wrap gap-2 justify-center">
            <button type="button" id="btn-gallery"
              class="px-4 py-2.5 rounded-xl bg-terra-500 hover:bg-terra-600 text-cream font-semibold text-sm transition flex items-center gap-2">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="9" cy="9" r="2"/>
                <path d="m21 15-5-5L5 21"/>
              </svg>
              Galerie
            </button>
            <button type="button" id="btn-camera"
              class="px-4 py-2.5 rounded-xl border border-charcoal/15 hover:bg-charcoal/5 font-semibold text-sm transition flex items-center gap-2">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
              Caméra
            </button>
          </div>

          <!-- Inputs cachés -->
          <input type="file" id="file-input" accept="image/*" multiple class="hidden">
          <input type="file" id="camera-input" accept="image/*" capture="environment" class="hidden">
        </div>

        <!-- Aperçus -->
        <div id="photos-preview" class="grid grid-cols-3 sm:grid-cols-5 gap-3 mt-4"></div>
        <p class="text-xs text-charcoal/50 mt-2">
          <span id="photo-count">0</span>/5 photos · Format JPG, PNG, WEBP · Max 5MB
        </p>
      </div>

      <!-- TITRE -->
      <div class="bg-white rounded-2xl p-5 border border-charcoal/5">
        <label class="block font-semibold mb-2">Titre <span class="text-red-500">*</span></label>
        <input type="text" id="title" required minlength="5" maxlength="100"
          class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none"
          placeholder="Ex: Nike Air Max 90 taille 42 en très bon état">
        <p class="text-xs text-charcoal/50 mt-1"><span id="title-count">0</span>/100</p>
      </div>

      <!-- CATÉGORIE (avec autocomplete) -->
      <div class="bg-white rounded-2xl p-5 border border-charcoal/5">
        <label class="block font-semibold mb-2">Catégorie <span class="text-red-500">*</span></label>
        <div class="relative">
          <input type="text" id="category-input" required autocomplete="off"
            class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none"
            placeholder="Ex: Chaussures, Téléphones, Robes...">
          <input type="hidden" id="category-id">
          
          <!-- Suggestions -->
          <div id="category-suggestions" class="hidden absolute top-full left-0 right-0 mt-2 bg-white border border-charcoal/10 rounded-xl shadow-xl max-h-72 overflow-y-auto z-50"></div>
        </div>
        <p class="text-xs text-charcoal/50 mt-2">
          💡 Si votre catégorie n'existe pas, elle sera ajoutée automatiquement.
        </p>
        <div id="new-category-badge" class="hidden mt-2 text-xs bg-green-100 text-green-700 px-3 py-2 rounded-lg">
          ✨ Nouvelle catégorie : sera créée automatiquement
        </div>
      </div>

      <!-- DESCRIPTION -->
      <div class="bg-white rounded-2xl p-5 border border-charcoal/5">
        <label class="block font-semibold mb-2">Description <span class="text-red-500">*</span></label>
        <textarea id="description" required rows="5" minlength="20" maxlength="1000"
          class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none resize-none"
          placeholder="Décrivez votre article : état, dimensions, couleur, raison de la vente..."></textarea>
        <p class="text-xs text-charcoal/50 mt-1"><span id="desc-count">0</span>/1000</p>
      </div>

      <!-- PRIX -->
      <div class="bg-white rounded-2xl p-5 border border-charcoal/5">
        <label class="block font-semibold mb-2">Prix <span class="text-red-500">*</span></label>
        <div class="relative">
          <input type="number" id="price" required min="100" step="100"
            class="w-full px-4 py-3 pr-16 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none"
            placeholder="15000">
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm font-semibold text-charcoal/50">FCFA</span>
        </div>
      </div>

      <!-- ÉTAT -->
      <div class="bg-white rounded-2xl p-5 border border-charcoal/5">
        <label class="block font-semibold mb-3">État <span class="text-red-500">*</span></label>
        <div class="grid grid-cols-2 gap-2">
          <label class="cursor-pointer">
            <input type="radio" name="condition" value="neuf_avec_etiquette" class="peer sr-only">
            <div class="px-4 py-3 rounded-xl border border-charcoal/10 bg-cream text-sm peer-checked:border-terra-500 peer-checked:bg-terra-50 peer-checked:text-terra-700 transition text-center">
              ✨ Neuf avec étiquette
            </div>
          </label>
          <label class="cursor-pointer">
            <input type="radio" name="condition" value="tres_bon_etat" class="peer sr-only" checked>
            <div class="px-4 py-3 rounded-xl border border-charcoal/10 bg-cream text-sm peer-checked:border-terra-500 peer-checked:bg-terra-50 peer-checked:text-terra-700 transition text-center">
              ⭐ Très bon état
            </div>
          </label>
          <label class="cursor-pointer">
            <input type="radio" name="condition" value="bon_etat" class="peer sr-only">
            <div class="px-4 py-3 rounded-xl border border-charcoal/10 bg-cream text-sm peer-checked:border-terra-500 peer-checked:bg-terra-50 peer-checked:text-terra-700 transition text-center">
              👍 Bon état
            </div>
          </label>
          <label class="cursor-pointer">
            <input type="radio" name="condition" value="satisfaisant" class="peer sr-only">
            <div class="px-4 py-3 rounded-xl border border-charcoal/10 bg-cream text-sm peer-checked:border-terra-500 peer-checked:bg-terra-50 peer-checked:text-terra-700 transition text-center">
              👌 Satisfaisant
            </div>
          </label>
        </div>
      </div>

      <!-- MARQUE + TAILLE -->
      <div class="bg-white rounded-2xl p-5 border border-charcoal/5">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block font-semibold mb-2 text-sm">Marque</label>
            <input type="text" id="brand"
              class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none"
              placeholder="Nike, Adidas...">
          </div>
          <div>
            <label class="block font-semibold mb-2 text-sm">Taille</label>
            <input type="text" id="size"
              class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none"
              placeholder="M, 42, XL...">
          </div>
        </div>
      </div>

      <!-- VILLE -->
      <div class="bg-white rounded-2xl p-5 border border-charcoal/5">
        <label class="block font-semibold mb-2">📍 Localisation</label>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <select id="city-select" class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none">
              <option value="">— Ville —</option>
              <option value="bamenda">Bamenda</option>
              <option value="bambili">Bambili (Campus)</option>
            </select>
          </div>
          <div>
            <select id="quarter-select" class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none" disabled>
              <option value="">— Quartier —</option>
            </select>
          </div>
        </div>
        <p class="text-xs text-charcoal/50 mt-1">Choisis d'abord la ville, puis le quartier</p>
      </div>

      <!-- Erreur -->
      <p id="error-msg" class="text-sm text-red-600 hidden"></p>

      <!-- Progress -->
      <div id="upload-progress" class="hidden bg-white rounded-2xl p-5 border border-charcoal/5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-semibold">Publication en cours...</span>
          <span id="progress-pct" class="text-sm font-bold text-terra-600">0%</span>
        </div>
        <div class="w-full h-2 bg-charcoal/5 rounded-full overflow-hidden">
          <div id="progress-bar" class="h-full bg-terra-500 rounded-full transition-all" style="width: 0%"></div>
        </div>
      </div>

      <!-- Submit -->
      <button type="submit" id="submit-btn"
        class="w-full py-4 rounded-xl bg-terra-500 hover:bg-terra-600 text-cream font-semibold transition shadow-lg shadow-terra-500/30">
        Publier l'article
      </button>

    </form>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="js/supabase-init.js"></script>
  <script>
    const $ = (id) => document.getElementById(id);
    let currentUser = null;
    let currentProfile = null;
    let uploadedPhotos = []; // URLs

    const MAX_PHOTOS = 5;
    const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5 MB

    // ============================================
    // INIT
    // ============================================
    (async () => {
      const { data: { session } } = await window.kwatta_db.auth.getSession();
      
      $('loading').classList.add('hidden');

      if (!session) {
        $('login-required').classList.remove('hidden');
        return;
      }

      currentUser = session.user;

      // Charge le profil
      const { data: profile } = await window.kwatta_db
        .from('profiles')
        .select('plan, total_sales, role, is_verified')
        .eq('id', currentUser.id)
        .single();
      
      currentProfile = profile || { total_sales: 0, is_verified: false };

      $('sell-content').classList.remove('hidden');
      await loadCategories();
    })();

    // ============================================
    // CATÉGORIES AVEC AUTOCOMPLETE
    // ============================================
    let allCategories = [];

    async function loadCategories() {
      const { data } = await window.kwatta_db
        .from('categories')
        .select('id, name, slug, parent_id')
        .order('display_order');
      
      allCategories = data || [];
      console.log('[SELL] Catégories chargées:', allCategories.length);
      setupCategoryAutocomplete();
    }

    function setupCategoryAutocomplete() {
      const input = $('category-input');
      const suggestions = $('category-suggestions');
      const hiddenId = $('category-id');
      const newBadge = $('new-category-badge');

      // Map des catégories par ID
      const byId = {};
      allCategories.forEach(c => byId[c.id] = c);

      // Récupère la hiérarchie complète d'une catégorie
      function getFullPath(cat) {
        const path = [cat.name];
        let current = cat;
        while (current.parent_id && byId[current.parent_id]) {
          current = byId[current.parent_id];
          path.unshift(current.name);
        }
        return path.join(' › ');
      }

      // Affiche TOUTES les catégories (par ordre hiérarchique)
      function showAllCategories() {
        const parents = allCategories.filter(c => !c.parent_id);
        let html = '';

        parents.forEach(parent => {
          // Catégorie niveau 1 (cliquable)
          html += `
            <button type="button" onclick="selectCategory(${parent.id}, '${parent.name.replace(/'/g, "\\'")}', '${parent.slug}')"
              class="w-full text-left px-4 py-2.5 hover:bg-terra-50 border-b border-charcoal/5 bg-cream/50 transition">
              <div class="font-bold text-sm text-terra-600">📁 ${parent.name}</div>
            </button>
          `;

          // Niveau 2
          const level2 = allCategories.filter(c => c.parent_id === parent.id);
          level2.forEach(child => {
            html += `
              <button type="button" onclick="selectCategory(${child.id}, '${child.name.replace(/'/g, "\\'")}', '${child.slug}')"
                class="w-full text-left px-6 py-2 hover:bg-terra-50 border-b border-charcoal/5 transition flex items-center gap-2">
                <span class="text-charcoal/30 text-xs">└─</span>
                <span class="text-sm font-medium">${child.name}</span>
              </button>
            `;

            // Niveau 3
            const level3 = allCategories.filter(c => c.parent_id === child.id);
            level3.forEach(sub => {
              html += `
                <button type="button" onclick="selectCategory(${sub.id}, '${sub.name.replace(/'/g, "\\'")}', '${sub.slug}')"
                  class="w-full text-left px-10 py-1.5 hover:bg-terra-50 border-b border-charcoal/5 last:border-0 transition flex items-center gap-2">
                  <span class="text-charcoal/20 text-xs">└─</span>
                  <span class="text-xs text-charcoal/70">${sub.name}</span>
                </button>
              `;
            });
          });
        });

        suggestions.innerHTML = html;
        suggestions.classList.remove('hidden');
      }

      input.addEventListener('focus', () => {
        showAllCategories();
      });

      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        hiddenId.value = '';
        newBadge.classList.add('hidden');

        if (query.length === 0) {
          showAllCategories();
          return;
        }

        // Filtre les catégories
        const matches = allCategories.filter(c => 
          c.name.toLowerCase().includes(query)
        ).slice(0, 20);

        if (matches.length > 0) {
          suggestions.innerHTML = matches.map(c => {
            const fullPath = getFullPath(c);
            const isLevel3 = c.parent_id && byId[c.parent_id] && byId[c.parent_id].parent_id;
            const icon = isLevel3 ? '└─' : (c.parent_id ? '📂' : '📁');
            
            return `
              <button type="button" onclick="selectCategory(${c.id}, '${c.name.replace(/'/g, "\\'")}', '${c.slug}')"
                class="w-full text-left px-4 py-3 hover:bg-terra-50 border-b border-charcoal/5 last:border-0 transition">
                <div class="flex items-center gap-2">
                  <span class="text-xs">${icon}</span>
                  <span class="font-medium text-sm">${c.name}</span>
                </div>
                <div class="text-xs text-charcoal/40 mt-0.5 ml-6">${fullPath}</div>
              </button>
            `;
          }).join('');
        } else {
          // Pas de match → propose de créer
          suggestions.innerHTML = `
            <div class="px-4 py-3 text-center">
              <div class="text-sm text-charcoal/60 mb-2">Aucune catégorie trouvée</div>
              <button type="button" onclick="createNewCategory()" 
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-terra-500 text-cream text-sm font-semibold hover:bg-terra-600">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                Créer "${input.value}"
              </button>
            </div>
          `;
        }

        suggestions.classList.remove('hidden');
      });

      // Ferme les suggestions au clic ailleurs
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#category-input') && !e.target.closest('#category-suggestions')) {
          suggestions.classList.add('hidden');
        }
      });
    }

    window.selectCategory = (id, name, slug) => {
      $('category-input').value = name;
      $('category-id').value = id;
      // Stocke aussi le slug pour usage ultérieur
      if (slug) $('category-input').dataset.slug = slug;
      $('category-suggestions').classList.add('hidden');
      $('new-category-badge').classList.add('hidden');
    };

    window.createNewCategory = async () => {
      const name = $('category-input').value.trim();
      if (!name) return;

      // Crée la catégorie dans Supabase
      const { data, error } = await window.kwatta_db
        .from('categories')
        .insert({ 
          name: name, 
          slug: name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+$/, ''),
          display_order: 999
        })
        .select()
        .single();

      if (error) {
        console.error(error);
        alert('Erreur: ' + error.message);
        return;
      }

      // Ajoute aux catégories locales
      allCategories.push(data);
      
      $('category-id').value = data.id;
      $('category-suggestions').classList.add('hidden');
      
      // Affiche le badge "nouvelle catégorie"
      $('new-category-badge').classList.remove('hidden');
    };

    // ============================================
    // UPLOAD PHOTOS
    // ============================================
    $('upload-zone').addEventListener('click', (e) => {
      if (e.target.closest('button')) return;
      $('file-input').click();
    });

    $('btn-gallery').addEventListener('click', (e) => {
      e.stopPropagation();
      $('file-input').click();
    });

    $('btn-camera').addEventListener('click', (e) => {
      e.stopPropagation();
      $('camera-input').click();
    });

    $('file-input').addEventListener('change', handleFiles);
    $('camera-input').addEventListener('change', handleFiles);

    async function handleFiles(e) {
      const files = Array.from(e.target.files);
      const remaining = MAX_PHOTOS - uploadedPhotos.length;
      
      if (remaining <= 0) {
        alert(`Maximum ${MAX_PHOTOS} photos`);
        return;
      }

      const toUpload = files.slice(0, remaining);
      
      for (const file of toUpload) {
        // Vérif taille
        if (file.size > MAX_FILE_SIZE) {
          alert(`"${file.name}" dépasse 5 MB`);
          continue;
        }
        
        try {
          const url = await uploadPhoto(file);
          uploadedPhotos.push(url);
          renderPhotoPreviews();
        } catch (err) {
          console.error('Upload error:', err);
          alert('Erreur d\'upload: ' + err.message);
        }
      }

      e.target.value = '';
    }

    async function uploadPhoto(file) {
      const ext = file.name.split('.').pop().toLowerCase();
      const filename = `${currentUser.id}/${Date.now()}-${Math.random().toString(36).slice(2)}.${ext}`;
      
      const { data, error } = await window.kwatta_db.storage
        .from('listings')
        .upload(filename, file, {
          cacheControl: '3600',
          upsert: false
        });

      if (error) throw error;

      const { data: { publicUrl } } = window.kwatta_db.storage
        .from('listings')
        .getPublicUrl(filename);

      return publicUrl;
    }

    function renderPhotoPreviews() {
      const preview = $('photos-preview');
      preview.innerHTML = uploadedPhotos.map((url, i) => `
        <div class="relative aspect-square rounded-xl overflow-hidden border border-charcoal/10 group">
          <img src="${url}" class="w-full h-full object-cover">
          <button type="button" onclick="window._removePhoto(${i})" 
            class="absolute top-1 right-1 w-6 h-6 rounded-full bg-black/60 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition">
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
      `).join('');
      $('photo-count').textContent = uploadedPhotos.length;
    }

    window._removePhoto = (index) => {
      uploadedPhotos.splice(index, 1);
      renderPhotoPreviews();
    };

    // ============================================
    // COMPTEURS
    // ============================================
    $('title').addEventListener('input', (e) => {
      $('title-count').textContent = e.target.value.length;
    });
    $('description').addEventListener('input', (e) => {
      $('desc-count').textContent = e.target.value.length;
    });

    // ============================================
    // SOUMISSION
    // ============================================
    // ============================================
    // SELECTS VILLE / QUARTIER
    // ============================================
    $('city-select').addEventListener('change', (e) => {
      const city = e.target.value;
      const quarterSelect = $('quarter-select');
      
      if (!city) {
        quarterSelect.innerHTML = '<option value="">— Quartier —</option>';
        quarterSelect.disabled = true;
        return;
      }
      
      quarterSelect.innerHTML = window.kwattaRenderQuarterOptions(city);
      quarterSelect.disabled = false;
    });

    $('sell-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const errEl = $('error-msg');
      errEl.classList.add('hidden');

      // Vérifs
      if (!currentUser) {
        window.kwattaOpenAuth && window.kwattaOpenAuth('signup');
        return;
      }

      if (uploadedPhotos.length === 0) {
        errEl.textContent = 'Ajoutez au moins 1 photo.';
        errEl.classList.remove('hidden');
        return;
      }

      const title = $('title').value.trim();
      const categoryId = parseInt($('category-id').value);
      if (!categoryId) { errEl.textContent = 'Choisissez une catégorie.'; errEl.classList.remove('hidden'); return; }
      const description = $('description').value.trim();
      const price = parseInt($('price').value);
      const condition = document.querySelector('input[name="condition"]:checked').value;
      const brand = $('brand').value.trim() || null;
      const size = $('size').value.trim() || null;
      const citySelect = $('city-select').value;
      const quarterSelect = $('quarter-select').value;
      
      if (!citySelect) {
        errEl.textContent = 'Choisis une ville.';
        errEl.classList.remove('hidden');
        return;
      }
      
      const city = window.kwattaBuildLocation(citySelect, quarterSelect);

      const btn = $('submit-btn');
      btn.disabled = true;
      btn.textContent = 'Publication...';
      $('upload-progress').classList.remove('hidden');
      $('progress-bar').style.width = '50%';
      $('progress-pct').textContent = '50%';

      const { data, error } = await window.kwatta_db
        .from('listings')
        .insert({
          seller_id: currentUser.id,
          category_id: categoryId,
          title, description,
          price_xaf: price,
          condition, brand, size,
          location_city: city,
          images: uploadedPhotos,
          status: (currentProfile.is_verified ? 'published' : 'pending_review')
        })
        .select()
        .single();

      if (error) {
        errEl.textContent = 'Erreur : ' + error.message;
        errEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Publier l\'article';
        $('upload-progress').classList.add('hidden');
        return;
      }

      // Met à jour le compteur de ventes
      await window.kwatta_db
        .from('profiles')
        .update({ total_sales: (currentProfile.total_sales || 0) + 1 })
        .eq('id', currentUser.id);

      $('progress-bar').style.width = '100%';
      $('progress-pct').textContent = '100%';

      setTimeout(() => {
        if (data.status === 'pending_review') {
          alert('✅ Annonce créée ! Elle sera visible après validation par un admin (généralement sous 24h).');
          window.location.href = 'profile.html';
        } else {
          window.location.href = 'product.html?id=' + data.id;
        }
      }, 500);
    });
  </script>
  <script src="js/bottom-nav.js" defer></script>
</body>
</html>
