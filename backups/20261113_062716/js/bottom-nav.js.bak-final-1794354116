// ============================================
// KWATTA — Bottom Navigation (injecté partout)
// ============================================
(function() {
  'use strict';

  // Ne pas injecter si on est sur une page admin
  if (window.location.pathname.includes('/admin/')) return;

  // Ne pas injecter si on est déjà sur une page qui l'a en dur
  if (document.querySelector('.bottom-nav')) {
    console.log('[BOTTOM-NAV] Déjà présent, skip');
    return;
  }

  // ============================================
  // Détermine la page actuelle pour surligner le bon item
  // ============================================
  function getCurrentPage() {
    const path = window.location.pathname;
    if (path.endsWith('index.html') || path.endsWith('/')) return 'home';
    if (path.includes('search.html')) return 'search';
    if (path.includes('sell.html')) return 'sell';
    if (path.includes('messages.html') || path.includes('chat.html')) return 'messages';
    if (path.includes('profile.html') || path.includes('wallet.html') || path.includes('commandes.html') || path.includes('offres.html')) return 'profile';
    return '';
  }

  // ============================================
  // Injecte le bottom-nav
  // ============================================
  function inject() {
    const current = getCurrentPage();

    const nav = document.createElement('nav');
    nav.className = 'bottom-nav';
    nav.style.cssText = 'position: fixed !important; bottom: 0 !important; left: 0 !important; right: 0 !important; z-index: 9999 !important; display: flex !important; justify-content: space-around !important; align-items: center !important; background: #fff !important; border-top: 1px solid #E2E7E2 !important; box-shadow: 0 -4px 20px rgba(12,26,22,0.08) !important; padding: 6px 0 8px !important; margin: 0 !important; width: 100vw !important; max-width: 100vw !important; box-sizing: border-box !important;';
    nav.innerHTML = `
      <a href="index.html" class="bottom-nav-item ${current === 'home' ? 'active' : ''}" style="display:flex; flex-direction:column; align-items:center; gap:2px; padding:6px 12px; color:${current === 'home' ? '#0E5C43' : '#5C6F69'}; font-size:10px; font-weight:500; text-decoration:none; min-width:60px; background:transparent; border:none;">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Accueil</span>
      </a>

      <a href="search.html" class="bottom-nav-item ${current === 'search' ? 'active' : ''}" style="display:flex; flex-direction:column; align-items:center; gap:2px; padding:6px 12px; color:${current === 'search' ? '#0E5C43' : '#5C6F69'}; font-size:10px; font-weight:500; text-decoration:none; min-width:60px; background:transparent; border:none;">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <span>Rechercher</span>
      </a>

      <a href="sell.html" class="bottom-nav-item bottom-nav-center ${current === 'sell' ? 'active' : ''}" style="display:flex; flex-direction:column; align-items:center; gap:2px; padding:6px 12px; color:#0E5C43; font-size:10px; font-weight:500; text-decoration:none; min-width:60px; background:transparent; border:none; position:relative;">
        <div class="w-12 h-12 rounded-full bg-terra-500 flex items-center justify-center -mt-6 shadow-lg shadow-terra-500/40">
          <svg width="24" height="24" fill="none" stroke="#fff" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M12 5v14M5 12h14"/>
          </svg>
        </div>
        <span>Vendre</span>
      </a>

      <a href="messages.html" class="bottom-nav-item ${current === 'messages' ? 'active' : ''}" style="display:flex; flex-direction:column; align-items:center; gap:2px; padding:6px 12px; color:${current === 'messages' ? '#0E5C43' : '#5C6F69'}; font-size:10px; font-weight:500; text-decoration:none; min-width:60px; background:transparent; border:none;">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <span>Messages</span>
      </a>

      <a href="profile.html" class="bottom-nav-item ${current === 'profile' ? 'active' : ''}" style="display:flex; flex-direction:column; align-items:center; gap:2px; padding:6px 12px; color:${current === 'profile' ? '#0E5C43' : '#5C6F69'}; font-size:10px; font-weight:500; text-decoration:none; min-width:60px; background:transparent; border:none;">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="4"/>
          <path d="M4 21v-2a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v2"/>
        </svg>
        <span>Profil</span>
      </a>
    `;

    document.body.appendChild(nav);
    
    // Ajouter du padding au body pour ne pas cacher le contenu
    document.body.style.paddingBottom = '80px';
    document.body.style.overflowX = 'hidden';
    document.body.style.width = '100%';
    document.body.style.maxWidth = '100vw';
    
    console.log('[BOTTOM-NAV] Injecté sur', current);
  }

  // ============================================
  // Attend que le DOM soit prêt
  // ============================================
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', inject);
  } else {
    inject();
  }

  // Ajouter un style global pour forcer la nav
  const style = document.createElement('style');
  style.textContent = `
    @media (max-width: 639px) {
      .bottom-nav {
        position: fixed !important;
        bottom: 0 !important;
        left: 0 !important;
        right: 0 !important;
        width: 100vw !important;
        max-width: 100vw !important;
        box-sizing: border-box !important;
        display: flex !important;
        justify-content: space-around !important;
        align-items: center !important;
        background: #fff !important;
        border-top: 1px solid #E2E7E2 !important;
        box-shadow: 0 -4px 20px rgba(12,26,22,0.08) !important;
        padding: 6px 0 8px !important;
        margin: 0 !important;
        z-index: 9999 !important;
      }
    }
    @media (min-width: 640px) {
      .bottom-nav {
        display: none !important;
      }
    }
  `;
  document.head.appendChild(style);
})();
