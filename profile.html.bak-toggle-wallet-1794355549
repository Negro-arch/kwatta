        </div>
        <div>
          <label class="block text-xs font-mono uppercase text-charcoal/50 mb-2">Bio</label>
          <textarea id="edit-bio" rows="3"
            class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none resize-none"
            placeholder="Parlez de vous..."></textarea>
