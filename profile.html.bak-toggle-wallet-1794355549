      <button id="edit-toggle" class="owner-only text-sm text-terra-600 font-medium hover:underline">
        Modifier
      </button>
      <button id="follow-btn-header" class="visitor-only hidden text-sm bg-charcoal text-cream px-3 py-1.5 rounded-lg font-semibold hover:bg-charcoal/90 transition">
        + Suivre
      </button>
    <button id="lang-toggle" class="w-9 h-9 rounded-lg hover:bg-charcoal/5 flex items-center justify-center text-xs font-bold" title="FR / EN" onclick="if(window.kwattaToggleLang) window.kwattaToggleLang()">
        <span id="current-lang">EN</span>
      </button>
      </div>
    
  </header>

  <!-- LOADING -->
  <div id="loading" class="text-center py-16">
    <div class="inline-block w-8 h-8 border-4 border-terra-500 border-t-transparent rounded-full animate-spin"></div>
  </div>

  <!-- CONTENU -->
  <main id="profile-content" class="hidden max-w-3xl mx-auto px-4 py-6 pb-24 sm:pb-8">

    <!-- Bandeau de vérification (rempli par JS) -->
    <div id="verification-banner" class="mb-4"></div>

    <!-- Carte profil -->
    <div class="bg-white rounded-2xl p-6 border border-charcoal/5 mb-6">
      <div class="flex items-start gap-4">
        <div class="relative shrink-0">
          <div id="avatar" class="w-20 h-20 rounded-full bg-terra-100 flex items-center justify-center font-display font-bold text-terra-600 text-3xl overflow-hidden cursor-pointer hover:opacity-80 transition" title="Changer ma photo de profil">
            ?
          </div>
          <button id="avatar-edit-btn" type="button" class="absolute bottom-0 right-0 w-7 h-7 rounded-full bg-terra-500 text-cream flex items-center justify-center shadow-lg hover:bg-terra-600 transition" title="Changer ma photo">
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
              <circle cx="12" cy="13" r="4"/>
