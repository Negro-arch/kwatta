          <div id="avatar-loading" class="hidden absolute inset-0 rounded-full bg-black/50 flex items-center justify-center pointer-events-none">
            <div class="w-6 h-6 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
          </div>
        </div>
        <div class="flex-1 min-w-0">
