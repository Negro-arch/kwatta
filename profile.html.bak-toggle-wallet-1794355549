        <div class="flex gap-2">
          <button type="button" id="cancel-edit" class="flex-1 py-3 rounded-xl border border-charcoal/10 font-semibold text-sm hover:bg-charcoal/5 transition">
            Annuler
          </button>
          <button type="submit" class="flex-1 py-3 rounded-xl bg-terra-500 hover:bg-terra-600 text-cream font-semibold text-sm transition">
            Enregistrer
