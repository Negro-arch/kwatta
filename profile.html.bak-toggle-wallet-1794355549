      <!-- Lien wallet -->
      <a href="wallet.html" class="owner-only mt-4 flex items-center justify-between p-4 bg-gradient-to-r from-terra-50 to-terra-100 border border-terra-200 rounded-2xl hover:from-terra-100 hover:to-terra-200 transition">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-terra-500 flex items-center justify-center text-cream">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
