      <h3 class="font-display font-bold text-lg mb-4">Modifier mon profil</h3>
      <form id="profile-form" class="space-y-4">
        <div>
          <label class="block text-xs font-mono uppercase text-charcoal/50 mb-2">Nom complet</label>
          <input type="text" id="edit-name" required
            class="w-full px-4 py-3 bg-cream border border-charcoal/10 rounded-xl text-sm focus:border-terra-500 outline-none">
        </div>
        <div>
          <label class="block text-xs font-mono uppercase text-charcoal/50 mb-2">📍 Localisation</label>
          <div class="grid grid-cols-2 gap-3">
